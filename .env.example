# Real values live in .env (gitignored) — never commit credentials.

# Cloudflare Images upload (tools/media-upload)
CF_ACCOUNT_ID=
CF_IMAGES_TOKEN=

# Interim store (WA-40) — local dev container: docker compose up -d postgres
DATABASE_URL=postgresql://fw:fw@localhost:15432/fw_interim

# Form security (WA-39). Unset locally = Turnstile dummy always-pass keys.
# Production values are Worker secrets set at the credential sitting.
TURNSTILE_SECRET=
DOC_SIGNING_KEY=
IP_SALT=

# Lead alerts (comma-separated). Unset = alerts logged to console only.
ALERT_EMAILS=
