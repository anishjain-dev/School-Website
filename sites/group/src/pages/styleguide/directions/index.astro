---
// Design-direction comparison hub (exploration surface, noindex, never
// linked from real pages). A = the shipped direction; B and C are
// recompositions of the same group-home content under variant token axes.
import '@fountainhead-web/tokens/index.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/nunito/400.css';
---

<!doctype html>
<html lang="en" data-brand="fountainhead">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Design directions — styleguide</title>
  </head>
  <body>
    <main>
      <h1>Design directions</h1>
      <p>Three treatments of the same group-home content. Pick with your gut, then with your parents' eyes.</p>
      <ul>
        <li>
          <a href="/"><strong>A — Prospectus Editorial</strong></a>
          <span>deep blue, angled cuts, spark marks, overlap · the currently shipped direction</span>
        </li>
        <li>
          <a href="/styleguide/directions/morning/"><strong>B — Morning Assembly</strong></a>
          <span>warm paper &amp; ink, light hero, red-forward, soft radii, centred calm</span>
        </li>
        <li>
          <a href="/styleguide/directions/blueprint/"><strong>C — Blueprint</strong></a>
          <span>dark, architectural grid, yellow rule-lines, sharp corners, dense</span>
        </li>
      </ul>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: var(--fh-color-bg);
    color: var(--fh-color-text);
    font-family: var(--fh-font-body);
  }
  main {
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--fh-space-16) var(--fh-space-6);
  }
  h1 {
    font-family: var(--fh-font-heading);
    font-weight: var(--fh-weight-extrabold);
    font-size: var(--fh-text-4xl);
    margin: 0 0 var(--fh-space-3);
  }
  p {
    color: var(--fh-color-text-muted);
    margin: 0 0 var(--fh-space-10);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--fh-space-5);
  }
  li {
    background: var(--fh-color-surface);
    border: var(--fh-border-width) solid var(--fh-color-border);
    border-radius: var(--fh-radius-lg);
    padding: var(--fh-space-6);
    display: grid;
    gap: var(--fh-space-2);
  }
  a {
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-xl);
    color: var(--fh-color-text-link);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  span {
    font-size: var(--fh-text-sm);
    color: var(--fh-color-text-muted);
  }
</style>
