---
// Footer: logo | social | campuses — minimal 3-section layout
import Spark from './Spark.astro';

interface Column {
  heading: string;
  links: { label: string; path: string }[];
}
interface Props {
  siteName: string;
  columns?: Column[] | undefined;
  address?: string | undefined;
  email?: string | undefined;
  phone?: string | undefined;
  coBrand?: string | undefined;
  social?: { label: string; url: string }[] | undefined;
  campuses?: { name: string; slug: string; shortName?: string | undefined }[] | undefined;
}
const { siteName, social, campuses } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer u-print-hidden">
  <div class="container footer-row">

    <!-- Logo -->
    <div class="ident">
      <p class="name"><Spark size={18} /> {siteName}</p>
    </div>

    <!-- Social -->
    {social && social.length > 0 && (
      <div class="social-block">
        <p class="col-h">Follow us</p>
        <ul class="social">
          {social.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.label}</a></li>
          ))}
        </ul>
      </div>
    )}

    <!-- Campuses -->
    {campuses && campuses.length > 0 && (
      <nav aria-label="Our campuses">
        <p class="col-h">Our Schools</p>
        <ul>
          {campuses.map((c) => (
            <li><a href={`/${c.slug}/`}>{c.shortName ?? c.name}</a></li>
          ))}
        </ul>
      </nav>
    )}

  </div>
  <div class="container legal">
    <p>© {year} Fountainhead Group. <a href="/child-protection/">Child protection</a> · <a href="/policies/">Policies</a> · Grievance: <a href="mailto:grievance@fountainheadschools.org">grievance@fountainheadschools.org</a></p>
  </div>
</footer>

<style>
  .footer {
    background: var(--fh-color-footer-bg);
    color: var(--fh-color-footer-fg);
    margin-top: var(--fh-space-24);
  }
  .footer-row {
    display: flex;
    align-items: flex-start;
    gap: var(--fh-space-16);
    padding-block: var(--fh-space-14) var(--fh-space-10);
  }
  .ident {
    flex: 1;
  }
  .name {
    display: flex;
    align-items: center;
    gap: var(--fh-space-2);
    font-family: var(--fh-font-heading);
    font-weight: var(--fh-weight-extrabold);
    font-size: var(--fh-text-xl);
    margin: 0;
  }
  .col-h {
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-xs);
    font-weight: var(--fh-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--fh-tracking-wider);
    opacity: 0.6;
    margin: 0 0 var(--fh-space-3);
  }
  .social {
    display: flex;
    flex-direction: column;
    gap: var(--fh-space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .social a {
    color: inherit;
    text-decoration: none;
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-sm);
    font-weight: var(--fh-weight-semibold);
  }
  .social a:hover {
    text-decoration: underline;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--fh-space-2);
  }
  ul a {
    color: inherit;
    text-decoration: none;
    font-size: var(--fh-text-sm);
  }
  ul a:hover {
    text-decoration: underline;
  }
  .legal {
    border-top: var(--fh-border-width) solid var(--fh-color-border-strong);
    padding-block: var(--fh-space-5);
    font-size: var(--fh-text-xs);
    opacity: 0.75;
  }
  .legal a {
    color: inherit;
  }
  @media (max-width: 600px) {
    .footer-row {
      flex-direction: column;
      gap: var(--fh-space-8);
    }
  }
</style>
