---
// The brand-yellow "spark of curiosity" — the site's signature mark.
// Inline SVG on currentColor; parents set `color` (defaults to the accent
// token via the .spark class). Decorative: aria-hidden always.
interface Props {
  size?: number;
  class?: string;
}
const { size = 14, class: className } = Astro.props;
---

<svg
  class:list={['spark', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
  <path d="M12 0c.6 6.4 5 10.8 12 12-7 1.2-11.4 5.6-12 12-.6-6.4-5-10.8-12-12C7 10.8 11.4 6.4 12 0Z"></path>
</svg>

<style>
  .spark {
    color: var(--fh-color-accent);
    flex-shrink: 0;
  }
</style>
