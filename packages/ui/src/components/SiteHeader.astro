---
// Campus-aware header. Utility strip carries the child-protection link
// (WA-23 locked: elevated AND listed under Policies). Mobile nav is the
// Popover API — zero JS; the browser manages button state.
//
// Two-level nav (WA-48) uses native <details name> — the exclusive
// accordion, so opening one group closes its siblings without script.
// Deliberately NOT a hover menu: hover-revealed submenus have to be
// dismissible under WCAG 1.4.13, which WA-21 makes binding, and there is
// no way to wire Escape without JS. A click-triggered disclosure sidesteps
// 1.4.13 entirely and gets correct button semantics from <summary> free.
import Spark from './Spark.astro';

export interface NavItem {
  label: string;
  path: string;
  current?: boolean;
  children?: NavItem[];
}

interface Props {
  siteName: string;
  shortName?: string | undefined;
  homePath: string;
  nav: NavItem[];
  enquirePath?: string | undefined;
  phone?: string | undefined;
}
const { siteName, shortName, homePath, nav, enquirePath, phone } = Astro.props;
---

<div class="utility u-print-hidden">
  <div class="container utility-row">
    <a href="/child-protection/">Child protection</a>
    {phone && <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>}
  </div>
</div>

<header class="header u-print-hidden">
  <div class="container header-row">
    <a class="lockup" href={homePath}>
      <Spark size={20} />
      <span class="lockup-name">{siteName}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {nav.map((item) =>
        item.children?.length ? (
          <details class="nav-group" name="primary-nav">
            <summary>{item.label}</summary>
            <div class="submenu">
              <a href={item.path} aria-current={item.current ? 'page' : undefined}>
                {item.label} overview
              </a>
              {item.children.map((child) => (
                <a href={child.path} aria-current={child.current ? 'page' : undefined}>{child.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <a href={item.path} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ),
      )}
    </nav>

    {enquirePath && <a class="enquire" href={enquirePath}>Enquire</a>}

    <button class="nav-toggle" popovertarget="site-nav" aria-label="Menu">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
  </div>
</header>

<nav id="site-nav" class="nav-panel" popover aria-label="Primary, mobile">
  {nav.map((item) =>
    item.children?.length ? (
      <details class="panel-group" name="mobile-nav">
        <summary>{item.label}</summary>
        <div class="panel-submenu">
          <a href={item.path} aria-current={item.current ? 'page' : undefined}>
            {item.label} overview
          </a>
          {item.children.map((child) => (
            <a href={child.path} aria-current={child.current ? 'page' : undefined}>{child.label}</a>
          ))}
        </div>
      </details>
    ) : (
      <a href={item.path} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
    ),
  )}
  {enquirePath && <a class="panel-enquire" href={enquirePath}>Enquire</a>}
</nav>

<style>
  /* ── Utility bar ─────────────────────────────────────────────────── */
  .utility {
    background: var(--fh-color-footer-bg);
    color: var(--fh-color-footer-fg);
    font-size: var(--fh-text-xs);
    font-family: var(--fh-font-heading);
    font-weight: var(--fh-weight-medium);
    letter-spacing: var(--fh-tracking-wider);
  }
  .utility-row {
    display: flex;
    justify-content: space-between;
    gap: var(--fh-space-6);
    padding-block: var(--fh-space-2);
  }
  .utility a {
    color: var(--fh-color-footer-fg);
    text-decoration: none;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .utility a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* ── Main header ──────────────────────────────────────────────────── */
  .header {
    background: var(--fh-color-header-bg);
    color: var(--fh-color-header-fg);
    /* Blue accent strip (WA-48 visual identity) */
    border-bottom: 3px solid var(--fh-color-primary);
    position: sticky;
    top: 0;
    z-index: var(--fh-z-sticky);
    box-shadow: var(--fh-shadow-sm);
    /* Prevent header children from causing horizontal page scroll */
    overflow-x: clip;
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: var(--fh-space-6);
    min-height: 3.75rem;
    min-width: 0;
  }

  /* ── Branding lockup ──────────────────────────────────────────────── */
  .lockup {
    display: flex;
    align-items: center;
    gap: var(--fh-space-2);
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }
  .lockup-name {
    font-family: var(--fh-font-heading);
    font-weight: var(--fh-weight-extrabold);
    font-size: var(--fh-text-base);
    letter-spacing: var(--fh-tracking-tight);
    line-height: var(--fh-leading-none);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lockup-chip {
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-xs);
    font-weight: var(--fh-weight-bold);
    letter-spacing: var(--fh-tracking-wider);
    color: var(--fh-color-primary-subtle-fg);
    background: var(--fh-color-primary-subtle);
    border-radius: var(--fh-radius-full);
    padding: var(--fh-space-1) var(--fh-space-3);
  }

  /* ── Desktop navigation ───────────────────────────────────────────── */
  .nav-desktop {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--fh-space-1);
    flex: 1;
  }
  .nav-desktop > a,
  .nav-group > summary {
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-sm);
    font-weight: var(--fh-weight-semibold);
    color: var(--fh-color-text-muted);
    text-decoration: none;
    padding: var(--fh-space-2) var(--fh-space-3);
    white-space: nowrap;
    border-radius: var(--fh-radius-sm);
    background: linear-gradient(var(--fh-color-primary), var(--fh-color-primary))
      no-repeat left bottom / 0 2px;
    transition:
      background-size var(--fh-duration-base) var(--fh-ease-standard),
      color var(--fh-duration-base) var(--fh-ease-standard);
  }
  .nav-desktop > a:hover,
  .nav-desktop > a[aria-current='page'] {
    background-size: calc(100% - var(--fh-space-6)) 2px;
    color: var(--fh-color-text);
  }

  /* Two-level disclosure (WA-48). <details name> = exclusive accordion, so
     opening one group closes its siblings with no script. */
  .nav-group {
    position: relative;
  }
  .nav-group > summary {
    display: flex;
    align-items: center;
    gap: var(--fh-space-1);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .nav-group > summary::-webkit-details-marker {
    display: none;
  }
  .nav-group > summary::after {
    content: '';
    width: 0.35em;
    height: 0.35em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.12em) rotate(45deg);
    transition: transform var(--fh-duration-base) var(--fh-ease-standard);
    opacity: 0.7;
  }
  .nav-group[open] > summary::after {
    transform: translateY(0.08em) rotate(-135deg);
  }
  .nav-group > summary:hover,
  .nav-group[open] > summary,
  .nav-group:has(a[aria-current='page']) > summary {
    background-size: calc(100% - var(--fh-space-6)) 2px;
    color: var(--fh-color-text);
  }

  /* ── Dropdown submenu ────────────────────────────────────────────── */
  .submenu {
    position: absolute;
    top: calc(100% + var(--fh-space-3));
    left: 0;
    min-width: 16rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--fh-space-2);
    background: var(--fh-color-surface);
    /* Blue top accent to tie dropdown to brand */
    border-top: 2px solid var(--fh-color-primary);
    border-left: var(--fh-border-width) solid var(--fh-color-border);
    border-right: var(--fh-border-width) solid var(--fh-color-border);
    border-bottom: var(--fh-border-width) solid var(--fh-color-border);
    border-radius: 0 0 var(--fh-radius-md) var(--fh-radius-md);
    box-shadow: var(--fh-shadow-lg);
    z-index: var(--fh-z-dropdown);
  }
  /* First link = "overview" — visually separated */
  .submenu a:first-child {
    font-weight: var(--fh-weight-bold);
    color: var(--fh-color-primary-text);
    margin-bottom: var(--fh-space-1);
    padding-bottom: var(--fh-space-2);
    border-bottom: var(--fh-border-width) solid var(--fh-color-border);
    border-radius: var(--fh-radius-sm) var(--fh-radius-sm) 0 0;
  }
  .submenu a {
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-sm);
    font-weight: var(--fh-weight-semibold);
    color: var(--fh-color-text);
    text-decoration: none;
    padding: var(--fh-space-2) var(--fh-space-3);
    border-radius: var(--fh-radius-sm);
    white-space: nowrap;
  }
  .submenu a:hover,
  .submenu a[aria-current='page'] {
    background: var(--fh-color-surface-sunken);
    color: var(--fh-color-primary-text);
  }

  /* ── Enquire CTA ─────────────────────────────────────────────────── */
  .enquire {
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-sm);
    font-weight: var(--fh-weight-bold);
    text-decoration: none;
    color: var(--fh-color-accent-fg);
    background: var(--fh-color-accent);
    border-radius: var(--fh-radius-full);
    padding: var(--fh-space-2) var(--fh-space-5);
    white-space: nowrap;
    flex-shrink: 0;
    transition: background var(--fh-duration-base) var(--fh-ease-standard),
                transform var(--fh-duration-base) var(--fh-ease-standard);
  }
  .enquire:hover {
    background: var(--fh-color-accent-hover);
    transform: translateY(-1px);
  }

  /* ── Hamburger toggle (mobile) ──────────────────────────────────── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: var(--fh-border-width) solid var(--fh-color-border);
    border-radius: var(--fh-radius-sm);
    padding: var(--fh-space-2) var(--fh-space-3);
    cursor: pointer;
  }
  .nav-toggle .bar {
    width: 20px;
    height: 2px;
    background: var(--fh-color-text);
    border-radius: 1px;
    transition: background var(--fh-duration-base);
  }
  .nav-toggle:hover .bar {
    background: var(--fh-color-primary);
  }

  /* ── Mobile nav panel ──────────────────────────────────────────── */
  .nav-panel {
    inset: auto var(--fh-space-4) auto auto;
    top: calc(var(--fh-space-20) + var(--fh-space-3));
    min-width: min(72vw, 20rem);
    max-height: calc(100dvh - var(--fh-space-24));
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 2px solid var(--fh-color-primary);
    border-left: var(--fh-border-width) solid var(--fh-color-border);
    border-right: var(--fh-border-width) solid var(--fh-color-border);
    border-bottom: var(--fh-border-width) solid var(--fh-color-border);
    border-radius: 0 0 var(--fh-radius-lg) var(--fh-radius-lg);
    background: var(--fh-color-surface);
    box-shadow: var(--fh-shadow-xl);
    padding: var(--fh-space-3);
    flex-direction: column;
    gap: var(--fh-space-1);
  }
  .nav-panel:popover-open {
    display: flex;
  }
  .nav-panel a {
    font-family: var(--fh-font-heading);
    font-weight: var(--fh-weight-semibold);
    font-size: var(--fh-text-sm);
    color: var(--fh-color-text);
    text-decoration: none;
    padding: var(--fh-space-3) var(--fh-space-4);
    border-radius: var(--fh-radius-sm);
  }
  .nav-panel a:hover {
    background: var(--fh-color-surface-sunken);
    color: var(--fh-color-primary-text);
  }
  .panel-enquire {
    color: var(--fh-color-accent-fg);
    background: var(--fh-color-accent);
    text-align: center;
    margin-top: var(--fh-space-2);
    border-radius: var(--fh-radius-full);
    font-weight: var(--fh-weight-bold);
  }
  .panel-enquire:hover {
    background: var(--fh-color-accent-hover);
    color: var(--fh-color-accent-fg);
  }

  /* Mobile second level — same disclosure, stacked and rule-indented. */
  .panel-group > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--fh-space-3);
    font-family: var(--fh-font-heading);
    font-weight: var(--fh-weight-semibold);
    font-size: var(--fh-text-sm);
    color: var(--fh-color-text);
    padding: var(--fh-space-3) var(--fh-space-4);
    border-radius: var(--fh-radius-sm);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .panel-group > summary::-webkit-details-marker {
    display: none;
  }
  .panel-group > summary::after {
    content: '';
    width: 0.35em;
    height: 0.35em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.12em) rotate(45deg);
    transition: transform var(--fh-duration-base) var(--fh-ease-standard);
    opacity: 0.7;
    flex-shrink: 0;
  }
  .panel-group[open] > summary::after {
    transform: translateY(0.08em) rotate(-135deg);
  }
  .panel-group > summary:hover {
    background: var(--fh-color-surface-sunken);
    color: var(--fh-color-primary-text);
  }
  .panel-submenu {
    display: flex;
    flex-direction: column;
    margin-left: var(--fh-space-4);
    padding-left: var(--fh-space-3);
    border-left: 2px solid var(--fh-color-primary-subtle);
    margin-bottom: var(--fh-space-1);
  }
  .panel-submenu a {
    font-size: var(--fh-text-sm);
    color: var(--fh-color-text-muted);
  }

  /* ── Responsive breakpoints ─────────────────────────────────────── */

  /* Desktop: full-width header row (no 1200px cap) — fits logo + 8 nav + Enquire */
  @media (min-width: 1025px) {
    .header-row {
      max-width: none;
      padding-inline: var(--fh-space-8);
      gap: var(--fh-space-4);
      min-height: 3.5rem;
    }
    .nav-desktop { gap: var(--fh-space-px); }
    .nav-desktop > a,
    .nav-group > summary {
      font-size: var(--fh-text-xs);
      padding: var(--fh-space-1) var(--fh-space-2);
    }
    .lockup-name { font-size: var(--fh-text-base); }
  }

  /* Mobile/tablet hamburger ≤1024px */
  @media (max-width: 1024px) {
    .nav-desktop { display: none; }
    .enquire { display: none; }
    .nav-toggle { display: flex; }
    .header-row { min-height: 3.25rem; }
    .lockup-name { font-size: var(--fh-text-base); }
  }

  @media (max-width: 360px) {
    .lockup-name { font-size: var(--fh-text-sm); }
  }

  /* Popover unsupported (old WebView): show the toggle-less stacked nav */
  @supports not selector(:popover-open) {
    .nav-toggle {
      display: none;
    }
    .nav-panel {
      display: none;
    }
    @media (max-width: 1024px) {
      .nav-desktop {
        display: flex;
        flex-wrap: wrap;
        gap: var(--fh-space-4);
        padding-block: var(--fh-space-2);
      }
      /* No popover, no room to float: drop the submenu into the flow so it
         cannot overflow the viewport on a narrow screen. */
      .nav-group {
        width: 100%;
      }
      .submenu {
        position: static;
        min-width: 0;
        box-shadow: none;
        border-radius: 0;
        border-top: none;
        border-left: 2px solid var(--fh-color-primary-subtle);
        border-right: none;
        margin-left: var(--fh-space-4);
      }
    }
  }
</style>
