---
// Premium IB school header — simple dropdowns + right-side mobile drawer.
// JS justified: hover menus need WCAG 1.4.13 hoverable/dismissible behaviour.
// Campus pages use zero-JS <details> accordion for the campus nav.
import Spark from './Spark.astro';

export interface NavItem {
  label: string;
  path: string;
  current?: boolean;
  children?: NavItem[];
}

interface Props {
  siteName: string;
  shortName?: string | undefined;
  homePath: string;
  nav: NavItem[];
  enquirePath?: string | undefined;
  phone?: string | undefined;
}

const { siteName, shortName, homePath, nav, enquirePath, phone } = Astro.props;
const isGroupSite = homePath === '/';

// Group site: 10-tab nav per IA spec. Simple single-column dropdowns only.
// Links only to pages confirmed in content/group/.
const GROUP_NAV = [
  {
    label: 'About Us',
    path: '/about/',
  },
  {
    label: 'Our Story',
    path: '/founders/',
    children: [
      { label: 'Our Story & Founders',          path: '/founders/' },
      { label: 'Values, Mission & Philosophy',  path: '/philosophy/' },
    ],
  },
  {
    label: 'Values',
    path: '/philosophy/',
    children: [
      { label: 'Values, Mission & Philosophy',  path: '/philosophy/' },
      { label: 'IB Mission Statement',          path: '/philosophy/ib-mission/' },
    ],
  },
  {
    label: 'Our Schools',
    path: '/our-schools/',
    children: [
      { label: 'All Our Schools',   path: '/our-schools/' },
      { label: 'Kunkni Campus',     path: '/kunkni/' },
      { label: 'Malgama Campus',    path: '/malgama/' },
      { label: 'Aurangabad Campus', path: '/fwgs/' },
      { label: 'Avadh Learning Hub',path: '/falh/' },
    ],
  },
  {
    label: 'Academics',
    path: '/academics/',
    children: [
      { label: 'Academics Overview',               path: '/academics/' },
      { label: 'Primary Years Programme (PYP)',    path: '/academics/pyp/' },
      { label: 'Middle Years Programme (MYP)',     path: '/academics/myp/' },
      { label: 'Diploma Programme (DP)',           path: '/academics/dp/' },
    ],
  },
  {
    label: 'Admissions',
    path: '/admissions/',
  },
  {
    label: 'News',
    path: '/news/',
  },
  {
    label: 'Accolades',
    path: '/accolades/',
  },
  {
    label: 'Voices',
    path: '/testimonials/',
    children: [
      { label: 'Hear From Our Students', path: '/testimonials/' },
      { label: 'Hear From Our Parents',  path: '/testimonials/' },
      { label: 'All Testimonials',       path: '/testimonials/' },
    ],
  },
  {
    label: 'Results',
    path: '/results/',
  },
];
---

<!----------  UTILITY STRIP — all pages (WA-23)  ---------->
<div class="util-strip u-print-hidden">
  <div class="util-inner">
    <a href="/child-protection/" class="util-link">Child Protection</a>
  </div>
</div>

<!----------  MAIN HEADER  ---------->
<header class="hdr u-print-hidden" id="fh-header">
  <div class="hdr-inner">

    <!--  Logo  -->
    <a class="logo" href={homePath} aria-label={siteName}>
      <Spark size={20} />
      <span class="logo-name">{siteName}</span>
      {shortName && <span class="logo-chip">{shortName}</span>}
    </a>

    <!--------  DESKTOP NAV  -------->
    {isGroupSite ? (
      <nav class="nav-d" aria-label="Primary" id="fh-nav">
        {GROUP_NAV.map(item =>
          item.children?.length ? (
            <div class="nd-item" data-menu={item.label}>
              <button
                class="nd-btn"
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
              >
                {item.label}
                <svg class="nd-chev" viewBox="0 0 10 6" fill="none" aria-hidden="true" width="9" height="5">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="dd" role="menu" hidden>
                {item.children.map(c => (
                  <a href={c.path} class="dd-link" role="menuitem">{c.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.path} class="nd-plain">{item.label}</a>
          )
        )}
      </nav>
    ) : (
      <nav class="nav-d nav-d--campus" aria-label="Primary">
        {nav.map(item =>
          item.children?.length ? (
            <details class="nd-group" name="campus-nav">
              <summary class="nd-btn nd-sum">
                {item.label}
                <svg class="nd-chev" viewBox="0 0 10 6" fill="none" aria-hidden="true" width="9" height="5">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </summary>
              <div class="dd">
                <a href={item.path} aria-current={item.current ? 'page' : undefined} class="dd-link dd-link--ov">{item.label} overview</a>
                {item.children.map(c => (
                  <a href={c.path} aria-current={c.current ? 'page' : undefined} class="dd-link">{c.label}</a>
                ))}
              </div>
            </details>
          ) : (
            <a href={item.path} aria-current={item.current ? 'page' : undefined} class="nd-plain">{item.label}</a>
          )
        )}
      </nav>
    )}

    <!--  Enquire CTA + hamburger  -->
    <div class="hdr-actions">
      {enquirePath && (
        <a class="btn-enquire" href={enquirePath}>Enquire</a>
      )}
      <button class="ham" id="fh-ham" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="fh-drawer">
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
      </button>
    </div>

  </div>
</header>

<!----------  MOBILE DRAWER + OVERLAY  ---------->
<div class="overlay" id="fh-overlay" aria-hidden="true"></div>

<nav class="drawer" id="fh-drawer" aria-label="Primary, mobile" aria-hidden="true">
  <div class="drawer-top">
    <a class="logo" href={homePath} aria-label={siteName}>
      <Spark size={18} />
      <span class="logo-name">{siteName}</span>
    </a>
    <button class="drawer-close" id="fh-drawer-close" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" width="20" height="20" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="drawer-body">
    {isGroupSite ? (
      <>
        {GROUP_NAV.map(item =>
          item.children?.length ? (
            <details class="mob-item">
              <summary class="mob-row mob-row--toggle">
                {item.label}
                <svg class="mob-chev" viewBox="0 0 10 6" fill="none" aria-hidden="true" width="10" height="6">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </summary>
              <div class="mob-sub">
                {item.children.map(c => (
                  <a href={c.path} class="mob-sub-link">{c.label}</a>
                ))}
              </div>
            </details>
          ) : (
            <div class="mob-item">
              <a href={item.path} class="mob-row">{item.label}</a>
            </div>
          )
        )}
      </>
    ) : (
      nav.map(item =>
        item.children?.length ? (
          <details class="mob-item">
            <summary class="mob-row mob-row--toggle">
              {item.label}
              <svg class="mob-chev" viewBox="0 0 10 6" fill="none" aria-hidden="true" width="10" height="6">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="mob-sub">
              <a href={item.path} aria-current={item.current ? 'page' : undefined} class="mob-sub-link">{item.label} overview</a>
              {item.children.map(c => (
                <a href={c.path} aria-current={c.current ? 'page' : undefined} class="mob-sub-link">{c.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <div class="mob-item">
            <a href={item.path} aria-current={item.current ? 'page' : undefined} class="mob-row">{item.label}</a>
          </div>
        )
      )
    )}
  </div>

  {enquirePath && (
    <div class="drawer-foot">
      <a href={enquirePath} class="btn-enquire btn-enquire--full">Enquire</a>
    </div>
  )}
</nav>

<style>
  /* ─────────────────────────────────────────
     UTILITY STRIP — all pages (WA-23)
  ───────────────────────────────────────── */
  .util-strip {
    background: var(--fh-neutral-900);
    text-align: center;
  }
  .util-inner {
    display: flex;
    align-items: center;
    height: 34px;
    padding-inline: var(--fh-space-6);
  }
  .util-link {
    font-family: var(--fh-font-heading);
    font-size: 0.6875rem;
    font-weight: var(--fh-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fh-yellow-400);
    text-decoration: none;
    transition: color var(--fh-duration-fast);
  }
  .util-link:hover { color: var(--fh-yellow-300); }

  /* ─────────────────────────────────────────
     MAIN HEADER
  ───────────────────────────────────────── */
  .hdr {
    background: var(--fh-neutral-0);
    position: sticky;
    top: 0;
    z-index: var(--fh-z-sticky);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--fh-duration-base),
      box-shadow var(--fh-duration-base);
  }
  .hdr.is-scrolled {
    border-color: var(--fh-neutral-100);
    box-shadow: 0 1px 8px rgba(11, 35, 65, 0.06);
  }
  .hdr-inner {
    padding-inline: var(--fh-space-8);
    display: flex;
    align-items: center;
    height: 80px;
    gap: var(--fh-space-8);
  }

  /* ─────────────────────────────────────────
     LOGO
  ───────────────────────────────────────── */
  .logo {
    display: flex;
    align-items: center;
    gap: var(--fh-space-2);
    text-decoration: none;
    color: var(--fh-blue-900);
    flex-shrink: 0;
  }
  .logo-name {
    font-family: var(--fh-font-heading);
    font-weight: var(--fh-weight-extrabold);
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .logo-chip {
    font-family: var(--fh-font-heading);
    font-size: 0.6875rem;
    font-weight: var(--fh-weight-bold);
    letter-spacing: 0.06em;
    color: var(--fh-blue-700);
    background: var(--fh-blue-50);
    border-radius: var(--fh-radius-full);
    padding: 2px var(--fh-space-3);
  }

  /* ─────────────────────────────────────────
     DESKTOP NAV
  ───────────────────────────────────────── */
  .nav-d {
    display: flex;
    align-items: center;
    gap: var(--fh-space-1);
    flex: 1;
    justify-content: center;
  }

  /* shared link / button style */
  .nd-btn,
  .nd-plain {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-family: var(--fh-font-heading);
    font-size: 0.84rem;
    font-weight: var(--fh-weight-semibold);
    color: var(--fh-neutral-700);
    text-decoration: none;
    background: none;
    border: none;
    padding: 8px 12px;
    border-radius: var(--fh-radius-md);
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--fh-duration-fast), background var(--fh-duration-fast);
  }
  .nd-btn:hover,
  .nd-plain:hover,
  .nd-plain[aria-current='page'],
  .nd-btn[aria-expanded='true'] {
    color: var(--fh-blue-900);
    background: var(--fh-neutral-100);
  }
  .nd-chev {
    opacity: 0.45;
    flex-shrink: 0;
    transition: transform var(--fh-duration-base) var(--fh-ease-standard);
  }
  .nd-btn[aria-expanded='true'] .nd-chev { transform: rotate(-180deg); opacity: 0.7; }

  /* nav item wrapper — needed for dropdown positioning */
  .nd-item { position: relative; }

  /* campus details fallback */
  .nd-group { position: relative; }
  .nd-sum { list-style: none; }
  .nd-sum::-webkit-details-marker { display: none; }
  .nd-group[open] .nd-chev { transform: rotate(-180deg); opacity: 0.7; }

  /* ─────────────────────────────────────────
     SIMPLE DROPDOWN
  ───────────────────────────────────────── */
  .dd {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 230px;
    background: var(--fh-neutral-0);
    border: 1px solid var(--fh-neutral-200);
    border-radius: var(--fh-radius-lg);
    box-shadow: var(--fh-shadow-lg);
    padding: var(--fh-space-2);
    z-index: var(--fh-z-dropdown);
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    transform: translateX(-50%) translateY(-4px);
    pointer-events: none;
    transition:
      opacity 160ms var(--fh-ease-standard),
      transform 160ms var(--fh-ease-standard);
  }
  .dd.is-open {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  /* campus simple dropdown (no animation needed) */
  .nd-group[open] .dd {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .dd-link {
    display: block;
    font-family: var(--fh-font-heading);
    font-size: 0.8125rem;
    font-weight: var(--fh-weight-medium);
    color: var(--fh-neutral-800);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: var(--fh-radius-md);
    white-space: nowrap;
    transition: background var(--fh-duration-fast), color var(--fh-duration-fast);
  }
  .dd-link:hover,
  .dd-link[aria-current='page'] {
    background: var(--fh-neutral-50);
    color: var(--fh-blue-900);
  }
  .dd-link--ov {
    color: var(--fh-neutral-500);
    font-size: 0.75rem;
    border-bottom: 1px solid var(--fh-neutral-100);
    padding-bottom: var(--fh-space-2);
    margin-bottom: 2px;
  }

  /* ─────────────────────────────────────────
     HEADER ACTIONS (enquire + hamburger)
  ───────────────────────────────────────── */
  .hdr-actions {
    display: flex;
    align-items: center;
    gap: var(--fh-space-3);
    flex-shrink: 0;
    margin-left: auto;
  }

  /* ─────────────────────────────────────────
     ENQUIRE BUTTON
  ───────────────────────────────────────── */
  .btn-enquire {
    display: inline-flex;
    align-items: center;
    font-family: var(--fh-font-heading);
    font-size: 0.8125rem;
    font-weight: var(--fh-weight-bold);
    letter-spacing: 0.01em;
    color: var(--fh-neutral-900);
    background: var(--fh-yellow-400);
    border-radius: var(--fh-radius-full);
    padding: 9px 22px;
    white-space: nowrap;
    text-decoration: none;
    transition: background var(--fh-duration-base), transform var(--fh-duration-fast);
  }
  .btn-enquire:hover { background: var(--fh-yellow-500); transform: translateY(-1px); }
  .btn-enquire:active { transform: none; }
  .btn-enquire--full { width: 100%; justify-content: center; font-size: 0.9375rem; padding: 13px 24px; }

  /* ─────────────────────────────────────────
     HAMBURGER
  ───────────────────────────────────────── */
  .ham {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    padding: var(--fh-space-2);
    cursor: pointer;
    border-radius: var(--fh-radius-md);
    color: var(--fh-neutral-800);
    transition: background var(--fh-duration-fast);
    min-width: 44px;
    min-height: 44px;
  }
  .ham:hover { background: var(--fh-neutral-100); }
  .ham-bar {
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--fh-duration-base), opacity var(--fh-duration-base);
  }

  /* ─────────────────────────────────────────
     OVERLAY
  ───────────────────────────────────────── */
  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(11, 35, 65, 0.45);
    z-index: calc(var(--fh-z-overlay) - 1);
    opacity: 0;
    transition: opacity var(--fh-duration-slow) var(--fh-ease-standard);
  }
  .overlay.is-open {
    display: block;
    opacity: 1;
  }

  /* ─────────────────────────────────────────
     MOBILE DRAWER
  ───────────────────────────────────────── */
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(85vw, 380px);
    background: var(--fh-neutral-0);
    z-index: var(--fh-z-overlay);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 280ms var(--fh-ease-emphasized);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .drawer.is-open {
    transform: translateX(0);
  }

  .drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--fh-space-4) var(--fh-space-5);
    border-bottom: 1px solid var(--fh-neutral-100);
    position: sticky;
    top: 0;
    background: var(--fh-neutral-0);
    z-index: 1;
    flex-shrink: 0;
  }

  .drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--fh-space-2);
    color: var(--fh-neutral-600);
    border-radius: var(--fh-radius-md);
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--fh-duration-fast), color var(--fh-duration-fast);
  }
  .drawer-close:hover { background: var(--fh-neutral-100); color: var(--fh-neutral-900); }

  .drawer-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--fh-space-2) 0;
  }

  .drawer-foot {
    padding: var(--fh-space-4) var(--fh-space-5) var(--fh-space-8);
    border-top: 1px solid var(--fh-neutral-100);
    flex-shrink: 0;
  }

  /* ─────────────────────────────────────────
     MOBILE NAV ITEMS
  ───────────────────────────────────────── */
  .mob-item {
    border-bottom: 1px solid var(--fh-neutral-100);
  }
  .mob-item:last-child { border-bottom: none; }

  .mob-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--fh-space-5);
    font-family: var(--fh-font-heading);
    font-size: 1rem;
    font-weight: var(--fh-weight-semibold);
    color: var(--fh-neutral-800);
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    transition: color var(--fh-duration-fast), background var(--fh-duration-fast);
    min-height: 56px;
  }
  .mob-row:hover { color: var(--fh-blue-900); }
  .mob-row[aria-current='page'] { color: var(--fh-blue-700); }

  .mob-row--toggle { list-style: none; cursor: pointer; }
  .mob-row--toggle::-webkit-details-marker { display: none; }

  .mob-chev {
    opacity: 0.45;
    flex-shrink: 0;
    transition: transform var(--fh-duration-base) var(--fh-ease-standard);
  }
  .mob-item[open] .mob-chev { transform: rotate(-180deg); opacity: 0.7; }
  .mob-item[open] .mob-row--toggle { color: var(--fh-blue-900); }

  .mob-sub {
    display: flex;
    flex-direction: column;
    padding: 0 var(--fh-space-5) var(--fh-space-3);
    gap: 2px;
    border-left: 2px solid var(--fh-yellow-400);
    margin-inline: var(--fh-space-5);
  }

  .mob-sub-link {
    display: block;
    font-family: var(--fh-font-heading);
    font-size: 0.875rem;
    font-weight: var(--fh-weight-medium);
    color: var(--fh-neutral-600);
    text-decoration: none;
    padding: 9px var(--fh-space-3);
    border-radius: var(--fh-radius-sm);
    transition: color var(--fh-duration-fast), background var(--fh-duration-fast);
  }
  .mob-sub-link:hover,
  .mob-sub-link[aria-current='page'] {
    color: var(--fh-blue-900);
    background: var(--fh-neutral-50);
  }

  /* ─────────────────────────────────────────
     RESPONSIVE — desktop ≥ 768px: full nav
     tablet/mobile < 768px: hamburger only
  ───────────────────────────────────────── */
  @media (max-width: 1099px) {
    .nav-d    { display: none; }
    .btn-enquire:not(.btn-enquire--full) { display: none; }
    .ham      { display: flex; }
  }
  @media (min-width: 1100px) {
    .ham      { display: none; }
    .overlay  { display: none !important; }
    .drawer   { display: none !important; }
  }
</style>

<!----------  SCRIPTS  ---------->
<script>
  // ── STICKY SHADOW ──────────────────────────────────────────────────────────
  const hdr = document.getElementById('fh-header');
  if (hdr) {
    const s = document.createElement('div');
    s.style.cssText = 'position:absolute;top:0;height:1px;width:1px;pointer-events:none';
    document.body.prepend(s);
    new IntersectionObserver(([e]) => hdr.classList.toggle('is-scrolled', !e.isIntersecting)).observe(s);
  }

  // ── DESKTOP DROPDOWNS ──────────────────────────────────────────────────────
  const nav = document.getElementById('fh-nav');
  if (nav) {
    let open: HTMLElement | null = null;
    let timer: ReturnType<typeof setTimeout> | null = null;

    function closeItem(item: HTMLElement) {
      const dd = item.querySelector<HTMLElement>('.dd');
      const btn = item.querySelector<HTMLElement>('.nd-btn');
      dd?.classList.remove('is-open');
      setTimeout(() => { if (!dd?.classList.contains('is-open')) dd?.setAttribute('hidden', ''); }, 170);
      btn?.setAttribute('aria-expanded', 'false');
    }

    function show(item: HTMLElement) {
      if (timer) { clearTimeout(timer); timer = null; }
      if (open === item) return;
      if (open) closeItem(open);
      open = item;
      const dd = item.querySelector<HTMLElement>('.dd');
      const btn = item.querySelector<HTMLElement>('.nd-btn');
      if (!dd || !btn) return;
      dd.removeAttribute('hidden');
      void dd.offsetHeight; // force reflow so CSS transition triggers
      dd.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
    }

    function hide(delay = 0) {
      if (timer) clearTimeout(timer);
      const closing = open;
      if (!closing) return;
      timer = setTimeout(() => {
        if (open !== closing) return;
        closeItem(closing);
        open = null;
        timer = null;
      }, delay);
    }

    nav.querySelectorAll<HTMLElement>('.nd-item').forEach(item => {
      item.addEventListener('pointerenter', () => show(item));
      item.addEventListener('pointerleave', () => hide(130));

      item.querySelector<HTMLElement>('.nd-btn')?.addEventListener('click', e => {
        e.preventDefault();
        open === item ? hide(0) : show(item);
      });
    });

    if (nav.querySelector('.dd')) {
      nav.querySelectorAll<HTMLElement>('.dd').forEach(dd => {
        dd.addEventListener('pointerenter', () => { if (timer) { clearTimeout(timer); timer = null; } });
        dd.addEventListener('pointerleave', () => hide(130));
      });
    }

    document.addEventListener('pointerdown', e => {
      if (!(e.target as Element).closest('.nd-item')) hide(0);
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && open) {
        const btn = open.querySelector<HTMLElement>('.nd-btn');
        hide(0);
        btn?.focus();
      }
    });
  }

  // ── MOBILE DRAWER ──────────────────────────────────────────────────────────
  const ham     = document.getElementById('fh-ham');
  const drawer  = document.getElementById('fh-drawer');
  const overlay = document.getElementById('fh-overlay');
  const closeBtn = document.getElementById('fh-drawer-close');

  function openDrawer() {
    if (!drawer || !overlay || !ham) return;
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    overlay.classList.add('is-open');
    ham.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    if (!drawer || !overlay || !ham) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('is-open');
    ham.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  ham?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
</script>
