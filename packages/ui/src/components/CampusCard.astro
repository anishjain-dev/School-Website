---
// Campus card for the group home — numbered like a prospectus index,
// whole-card clickable, hover lift. Photo-free: the oversized numeral IS
// the visual.
interface Props {
  index: number;
  name: string;
  city: string;
  path: string;
  descriptor?: string | undefined;
}
const { index, name, city, path, descriptor } = Astro.props;
const nn = String(index).padStart(2, '0');
---

<article class="card">
  <p class="numeral" aria-hidden="true">{nn}</p>
  <h3><a href={path}>{name}</a></h3>
  <p class="city">{city}</p>
  {descriptor && <p class="desc">{descriptor}</p>}
  <p class="go" aria-hidden="true">Visit campus →</p>
</article>

<style>
  .card {
    position: relative;
    background: var(--fh-color-surface);
    border: var(--fh-border-width) solid var(--fh-color-border);
    border-top: var(--fh-space-1) solid var(--fh-color-primary);
    border-radius: var(--fh-radius-lg);
    padding: var(--fh-space-6);
    display: grid;
    gap: var(--fh-space-2);
    transition: transform var(--fh-duration-base) var(--fh-ease-standard),
      box-shadow var(--fh-duration-base) var(--fh-ease-standard);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--fh-shadow-lg);
  }
  .numeral {
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-5xl);
    font-weight: var(--fh-weight-extrabold);
    line-height: var(--fh-leading-none);
    /* grey folio numeral — large-text AA (≥3:1), watermark feel intact */
    color: var(--fh-color-text-subtle);
  }
  h3 {
    font-size: var(--fh-text-xl);
    font-weight: var(--fh-weight-bold);
  }
  h3 a {
    color: var(--fh-color-text);
    text-decoration: none;
  }
  /* whole-card click */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .city {
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-xs);
    font-weight: var(--fh-weight-semibold);
    letter-spacing: var(--fh-tracking-wider);
    text-transform: uppercase;
    color: var(--fh-color-text-muted);
  }
  .desc {
    font-size: var(--fh-text-sm);
    color: var(--fh-color-text-muted);
    line-height: var(--fh-leading-normal);
  }
  .go {
    margin-top: var(--fh-space-2);
    font-family: var(--fh-font-heading);
    font-size: var(--fh-text-sm);
    font-weight: var(--fh-weight-bold);
    color: var(--fh-color-primary-text);
  }
</style>
