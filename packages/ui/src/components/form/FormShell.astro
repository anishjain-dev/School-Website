---
// Shared form wrapper: POST + honeypot + privacy notice + submit. The
// Turnstile widget slots in at Stage 7 with the live endpoints (WA-39) —
// until then the markup is real and the action 404s harmlessly.
import PrivacyNotice from './PrivacyNotice.astro';
import TurnstileWidget from './TurnstileWidget.astro';

interface Props {
  action: string;
  heading?: string | undefined;
  purpose: string;
  retention: string;
  noticeVersion?: string;
  submitLabel?: string;
}
const { action, heading, purpose, retention, noticeVersion = 'v0.1 (pre-launch)', submitLabel = 'Send enquiry' } =
  Astro.props;
---

<form class="shell" method="post" action={action}>
  {heading && <h2>{heading}</h2>}
  <div class="fields">
    <slot />
  </div>

  <!-- honeypot: humans never see it; bots fill it (WA-39 edge layer) -->
  <div class="hp" aria-hidden="true">
    <label for="f-website">Website</label>
    <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <!-- The one sanctioned island (WA-39): every form carries Turnstile -->
  <TurnstileWidget />

  <PrivacyNotice purpose={purpose} retention={retention} noticeVersion={noticeVersion} />

  <button type="submit">{submitLabel}</button>
</form>

<style>
  .shell {
    display: grid;
    gap: var(--fh-space-6);
    background: var(--fh-color-surface);
    border: var(--fh-border-width) solid var(--fh-color-border);
    border-top: var(--fh-space-1) solid var(--fh-color-accent);
    border-radius: var(--fh-radius-lg);
    padding: var(--fh-space-8);
    box-shadow: var(--fh-shadow-sm);
  }
  h2 {
    font-size: var(--fh-text-2xl);
    font-weight: var(--fh-weight-extrabold);
  }
  .fields {
    display: grid;
    gap: var(--fh-space-5);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  button {
    justify-self: start;
    font-family: var(--fh-font-heading);
    font-weight: var(--fh-weight-bold);
    font-size: var(--fh-text-sm);
    color: var(--fh-color-primary-fg);
    background: var(--fh-color-primary);
    border: 0;
    border-radius: var(--fh-radius-full);
    height: var(--fh-control-height-lg);
    padding-inline: var(--fh-space-8);
    cursor: pointer;
    transition: background var(--fh-duration-base) var(--fh-ease-standard);
  }
  button:hover {
    background: var(--fh-color-primary-hover);
  }
</style>
